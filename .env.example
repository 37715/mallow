# Analytics (§11) — leave unset in dev to log events to the console instead.
# Create a (free) TelemetryDeck app and paste its ID to start recording:
VITE_TELEMETRYDECK_APP_ID=
# Only needed if your TelemetryDeck org uses a namespace:
# VITE_TELEMETRYDECK_ENDPOINT=https://nom.telemetrydeck.com/v2/namespace/<your-namespace>/
